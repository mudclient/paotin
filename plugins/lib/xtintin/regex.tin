#nop 本文件是 xtintin 的一部分，实现了一些正则表达式生成函数;

///=== {
///// 正则表达式生成函数：
/////
// #@ re.TableHeader <表格名称>
//    生成一个正则表达式，用来匹配一个表格的表头。
//
// #@ re.TableTail
//    生成一个正则表达式，用来匹配一个表格的结尾。
//
// #@ util.CurrentClass
//    获取当前 class 的名称。
// };
#func {re.TableHeader} {
    #local title {%1};
    #local class {@util.CurrentClass{}};
    #return {^╭─{?:(?:─|┬)+}$title{?:(?:─|┬)+}─╮{|$class}$};
};

#func {re.TableTail} {
    #local class {@util.CurrentClass{}};
    #local end {@default{%0;$class}};
    #return {^╰─{?:(?:─|┴)+}%u{?:(?:─|┴)+}─╯{|$end}$};
};

#func {util.CurrentClass} {
    #line quiet #info classes save;
    #return {$info[CLASSES][1][arg1]};
};
