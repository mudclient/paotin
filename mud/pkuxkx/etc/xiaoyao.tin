#nop vim: set filetype=tt fdm=syntax:;

VAR {逍遥行特殊路径} map.xiaoyao.FixPath {
    {兰州黄河渡口(黄河北岸的赤套渡北渡口)}
    {
        {黄河北岸码头(黄河北岸的黄河古渡)} {PATH/ne}
    }
    {黄河北岸码头(黄河北岸的黄河古渡)}
    {
        {兰州黄河渡口(黄河北岸的赤套渡北渡口)} {PATH/sw}
    }
    {济源(河北的济源)}
    {
        {黄河北岸码头(黄河北岸的渡口)} {PATH/sd}
    }
    {黄河北岸码头(黄河北岸的渡口)}
    {
        {济源(河北的济源)} {PATH/nu}
    }
    {秦州(秦州的中央广场)}
    {
        {秦州码头(秦州的耤河南岸)} {PATH/{e;e;e;e;e;e}}
    }
    {秦州码头(秦州的耤河南岸)}
    {
        {秦州(秦州的中央广场)} {PATH/{w;w;w;w;w;w}}
    }
    {湟中码头(湟中的湟南渡口)}
    {
        {湟中(湟中的湟中中心)} {PATH/{sw;s;s;s;s}}
    }
    {临安府钱塘东渡口(临安府的钱塘东渡口)}
    {
        {临安府钱塘北渡口(临安府的钱塘北渡口)} {Ride/north}
        {临安府钱塘西渡口(临安府的钱塘西渡口)} {Ride/west}
    }
};

VAR {逍遥行BUG节点} map.xiaoyao.FixNode {
    {汉水北岸} {汉江自西向东奔流而过，在金牛县南境拐出一道弯，江面宽阔，水势湍急，唯有此处}
    {汉水南岸} {这里是汉水以南的一座小渡口，往南穿过金牛道可通往广元。}
};

VAR {逍遥行BUG区域} map.xiaoyao.FixArea {
    {天台山} {
        {LMAP} {天台山}
        {NODE} {天台山;天台县}
    }
    {台州府} {
        {LMAP} {台州府}
        {NODE} {台州府;灵江东岸;灵江西岸;灵江南岸;灵江北岸}
    }
};

VAR {逍遥行故障节点} map.xiaoyao.BlockNode {山宗};
